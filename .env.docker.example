# ==========================================
# Brainfy Docker Deployment Environment Variables
# ==========================================

# Port mappings on host machine
FRONTEND_PORT=3000
BACKEND_PORT=5000
MONGO_PORT=27018

# Security credentials
JWT_SECRET=replace_with_a_long_random_secure_secret_string
JWT_EXPIRES_IN=1d

# Allowed Origin for CORS
CLIENT_URL=http://localhost:3000
